+// COUNT (r8): with COUNT_LOG=<dir>, every base-case decision of the union mode appends one line
+//   m V K1 K K0 ovf ovf0 calls_c8 calls_A yes
+// to <dir>/<pid>.txt:  m = cut discs, V = vertices of the authors' arrangement for the same discs,
+// radius and box (what the authors' base case tests), K1 = candidate5 witnesses (union stage 1),
+// K = box family at the enumeration radius in use (candidate8: distance + s), K0 = box family at
+// radius distance (s = 0), ovf / ovf0 = the box family fell back to box-arrangement vertices,
+// calls_c8 = decider calls this decision made, calls_A = decider calls the authors' base case makes
+// on this decision (vertices in CGAL order until the first YES; 1 for an empty arrangement),
+// yes = the answer.  Counting only: the answer and the search are unchanged.
+namespace
+{
+std::FILE* count_file()
+{
+	static std::FILE* f = [] () -> std::FILE* {
+		char const* dir = std::getenv("COUNT_LOG");
+		if (!dir || !*dir) { return nullptr; }
+		std::string path = std::string(dir) + "/" + std::to_string(::getpid()) + ".txt";
+		return std::fopen(path.c_str(), "a");
+	}();
+	return f;
+}
+} // end anonymous namespace
